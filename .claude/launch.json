{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 5173
    },
    {
      "name": "backend-api",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["-Denforcer.skip=true", "spring-boot:run", "-Dspring-boot.run.profiles=local"],
      "cwd": "backend",
      "port": 8080,
      "env": {
        "FIREBASE_ENABLED": "false",
        "DEVELOPMENT_AUTH_ENABLED": "true"
      }
    }
  ]
}
